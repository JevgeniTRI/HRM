HRM_DATABASE_URL=sqlite:///./hrm.db
HRM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:8000","http://127.0.0.1:8000"]
HRM_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# Для HTTPS включите Secure cookie. Для локального HTTP оставьте false.
HRM_COOKIE_SECURE=false
HRM_SESSION_HOURS=12
# По умолчанию: папка media в корне проекта, независимо от рабочей директории.
# HRM_MEDIA_ROOT=C:/path/to/project/media
